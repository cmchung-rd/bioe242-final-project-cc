	<SimulationModifiers>
		<VolumeTrackingModifier-2>
		</VolumeTrackingModifier-2>
		<SimpleTargetAreaModifier-2>
			<GrowthDuration>1.79769e+308</GrowthDuration>
			<ReferenceTargetArea>1</ReferenceTargetArea>
		</SimpleTargetAreaModifier-2>
		<NeighborDependentProliferationModifier-2>
			<NeighborThreshold>6</NeighborThreshold>
		</NeighborDependentProliferationModifier-2>
	</SimulationModifiers>

	<Forces>
		<NagaiHondaForce-2>
			<NagaiHondaDeformationEnergyParameter>55</NagaiHondaDeformationEnergyParameter>
			<NagaiHondaMembraneSurfaceEnergyParameter>1</NagaiHondaMembraneSurfaceEnergyParameter>
			<NagaiHondaCellCellAdhesionEnergyParameter>0.5</NagaiHondaCellCellAdhesionEnergyParameter>
			<NagaiHondaCellBoundaryAdhesionEnergyParameter>1</NagaiHondaCellBoundaryAdhesionEnergyParameter>
			<NagaiHondaTargetAreaParameter>1</NagaiHondaTargetAreaParameter>
		</NagaiHondaForce-2>
	</Forces>

	<CellPopulationBoundaryConditions>
		<PlaneBoundaryCondition-2-2>
			<PointOnPlane>0,0</PointOnPlane>
			<NormalToPlane>0,-1</NormalToPlane>
			<UseJiggledNodesOnPlane>0</UseJiggledNodesOnPlane>
		</PlaneBoundaryCondition-2-2>
		<PlaneBoundaryCondition-2-2>
			<PointOnPlane>0,8</PointOnPlane>
			<NormalToPlane>0,1</NormalToPlane>
			<UseJiggledNodesOnPlane>0</UseJiggledNodesOnPlane>
		</PlaneBoundaryCondition-2-2>
