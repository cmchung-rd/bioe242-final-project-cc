	<SimulationModifiers>
		<VolumeTrackingModifier-2>
		</VolumeTrackingModifier-2>
		<SimpleTargetAreaModifier-2>
			<GrowthDuration>1.79769e+308</GrowthDuration>
			<ReferenceTargetArea>1</ReferenceTargetArea>
		</SimpleTargetAreaModifier-2>
		<NeighborDependentProliferationModifier-2>
			<NeighborThreshold>6</NeighborThreshold>
		</NeighborDependentProliferationModifier-2>
	</SimulationModifiers>

	<Forces>
		<FarhadifarForce-2>
			<AreaElasticityParameter>4</AreaElasticityParameter>
			<PerimeterContractilityParameter>0.04</PerimeterContractilityParameter>
			<LineTensionParameter>0.12</LineTensionParameter>
			<BoundaryLineTensionParameter>0.12</BoundaryLineTensionParameter>
			<TargetAreaParameter>1</TargetAreaParameter>
		</FarhadifarForce-2>
		<UnknownClass-ReflectionFailed>
			<ActiveForceMagnitude>0.1</ActiveForceMagnitude>
			<BoxHeight>4</BoxHeight>
		</UnknownClass-ReflectionFailed>
	</Forces>

	<CellPopulationBoundaryConditions>
		<PlaneBoundaryCondition-2-2>
			<PointOnPlane>0,0</PointOnPlane>
			<NormalToPlane>0,-1</NormalToPlane>
			<UseJiggledNodesOnPlane>0</UseJiggledNodesOnPlane>
		</PlaneBoundaryCondition-2-2>
		<PlaneBoundaryCondition-2-2>
			<PointOnPlane>0,4</PointOnPlane>
			<NormalToPlane>0,1</NormalToPlane>
			<UseJiggledNodesOnPlane>0</UseJiggledNodesOnPlane>
		</PlaneBoundaryCondition-2-2>
		<PlaneBoundaryCondition-2-2>
			<PointOnPlane>0,0</PointOnPlane>
			<NormalToPlane>-1,0</NormalToPlane>
			<UseJiggledNodesOnPlane>0</UseJiggledNodesOnPlane>
		</PlaneBoundaryCondition-2-2>
		<PlaneBoundaryCondition-2-2>
			<PointOnPlane>15,0</PointOnPlane>
			<NormalToPlane>1,0</NormalToPlane>
			<UseJiggledNodesOnPlane>0</UseJiggledNodesOnPlane>
		</PlaneBoundaryCondition-2-2>
	</CellPopulationBoundaryConditions>

	<NumericalMethod>
		<ForwardEulerNumericalMethod-2-2>
			<UseAdaptiveTimestep>0</UseAdaptiveTimestep> 
			<UseUpdateNodeLocation>0</UseUpdateNodeLocation> 
			<GhostNodeForcesEnabled>0</GhostNodeForcesEnabled> 
		</ForwardEulerNumericalMethod-2-2>
	</NumericalMethod>

</Chaste>
